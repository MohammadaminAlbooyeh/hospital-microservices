{
  "type": "record",
  "namespace": "com.hospital.events",
  "name": "LabResultReady",
  "doc": "Emitted by lab-service when a result is verified and released. Consumers: notification-service (patient/doctor alert), encounter-service (advance clinical workflow), ehr-service (append result to the record), billing-service (add lab charge), analytics-service, audit-service.",
  "fields": [
    {
      "name": "labOrderId",
      "type": "string",
      "doc": "Lab order UUID; also used as the Kafka message key."
    },
    {
      "name": "patientId",
      "type": "string",
      "doc": "Patient UUID from patient-service."
    },
    {
      "name": "testCode",
      "type": "string",
      "doc": "LOINC-style test code, e.g. 58410-2."
    },
    {
      "name": "resultSummary",
      "type": ["null", "string"],
      "default": null,
      "doc": "Short, non-diagnostic summary for notifications. Full values stay in lab-service/EHR."
    },
    {
      "name": "critical",
      "type": "boolean",
      "default": false,
      "doc": "True when the result crosses a critical threshold and needs urgent review."
    },
    {
      "name": "readyAt",
      "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}],
      "default": null,
      "doc": "Instant the result was released."
    }
  ]
}
