{
  "type": "record",
  "namespace": "com.hospital.events",
  "name": "InvoiceIssued",
  "doc": "Emitted by billing-service after an invoice is assembled and issued to the patient/insurer. Consumers: notification-service (invoice notice), insurance-service (claim submission), document-service (PDF invoice), analytics-service (revenue), audit-service.",
  "fields": [
    {
      "name": "invoiceId",
      "type": "string",
      "doc": "Invoice UUID; also used as the Kafka message key."
    },
    {
      "name": "encounterId",
      "type": ["null", "string"],
      "default": null,
      "doc": "Encounter UUID the invoice was assembled from."
    },
    {
      "name": "patientId",
      "type": "string",
      "doc": "Patient UUID responsible for the patient share."
    },
    {
      "name": "totalAmount",
      "type": "double",
      "doc": "Total invoice amount in `currency` major units."
    },
    {
      "name": "patientShare",
      "type": "double",
      "doc": "Amount payable by the patient in `currency` major units."
    },
    {
      "name": "insurerShare",
      "type": "double",
      "doc": "Amount expected from the insurer in `currency` major units."
    },
    {
      "name": "currency",
      "type": "string",
      "default": "USD",
      "doc": "ISO-4217 currency code."
    },
    {
      "name": "issuedAt",
      "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}],
      "default": null,
      "doc": "Instant the invoice was issued."
    }
  ]
}
