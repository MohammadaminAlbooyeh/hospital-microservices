{
  "type": "record",
  "namespace": "com.hospital.events",
  "name": "AppointmentBooked",
  "doc": "Emitted by appointment-service after a slot is successfully locked and the appointment is persisted. Consumers: notification-service (SMS confirmation), ml-prediction-service (no-show feature update and risk score), analytics-service (booking funnel), audit-service.",
  "fields": [
    {
      "name": "appointmentId",
      "type": "string",
      "doc": "Appointment UUID; also used as the Kafka message key."
    },
    {
      "name": "patientId",
      "type": "string",
      "doc": "Patient UUID from patient-service."
    },
    {
      "name": "doctorId",
      "type": "string",
      "doc": "Doctor UUID from doctor-service."
    },
    {
      "name": "departmentId",
      "type": ["null", "string"],
      "default": null,
      "doc": "Department UUID from department-service, when known."
    },
    {
      "name": "slotStart",
      "type": {"type": "long", "logicalType": "timestamp-millis"},
      "doc": "Appointment slot start instant (UTC epoch millis)."
    },
    {
      "name": "slotEnd",
      "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}],
      "default": null,
      "doc": "Appointment slot end instant (UTC epoch millis)."
    },
    {
      "name": "bookedAt",
      "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}],
      "default": null,
      "doc": "Instant the booking was committed."
    }
  ]
}
