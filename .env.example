# ---------------------------------------------------------------------------
# Hospital Platform - local environment
# Copy to .env and adjust as needed:  cp .env.example .env
# ---------------------------------------------------------------------------

# PostgreSQL (one logical database per service, single local instance)
POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# TimescaleDB (analytics time series)
TIMESCALE_USER=hospital
TIMESCALE_PASSWORD=hospital
TIMESCALE_DB=hospital_analytics
TIMESCALE_PORT=5433

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=hospital.events

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Keycloak (identity provider, optional local mode)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8180
KEYCLOAK_REALM=hospital

# Shared JWT secret (HS256, must be >= 32 bytes)
JWT_SECRET=change-me-in-production-super-secret-key-0123456789abcdef

# Service discovery / config
EUREKA_URL=http://config-discovery-service:8888/eureka/
CONFIG_SERVER_URL=http://config-discovery-service:8888

# Gateway
GATEWAY_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Service ports (host-side)
AUTH_PORT=8081
PATIENT_PORT=8082
APPOINTMENT_PORT=8083
DOCTOR_PORT=8084
DEPARTMENT_PORT=8085
ENCOUNTER_PORT=8086
EHR_PORT=8087
PRESCRIPTION_PORT=8088
LAB_PORT=8089
PHARMACY_PORT=8090
BILLING_PORT=8091
PAYMENT_PORT=8092
TRIAGE_PORT=8001
INSURANCE_PORT=8002
NOTIFICATION_PORT=8003
ANALYTICS_PORT=8004
ML_PORT=8005
DOCUMENT_PORT=8006
AUDIT_PORT=8007

# Internal client URLs
INSURANCE_SERVICE_URL=http://insurance-service:8002
PRESCRIPTION_SERVICE_URL=http://prescription-service:8088
DOCUMENT_SERVICE_URL=http://document-service:8006
ML_SERVICE_URL=http://ml-prediction-service:8005

# SMTP / Twilio (notification-service)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=no-reply@hospital.local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
